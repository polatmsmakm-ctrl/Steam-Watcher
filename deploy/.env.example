# Public DNS name pointing at this server (Caddy obtains the TLS certificate for it).
DOMAIN=stream.example.com
# Public IPv4 address of this server (announced to WebRTC clients).
PUBLIC_IP=203.0.113.10
# Long random string shared by the room service and coturn:  openssl rand -hex 32
TURN_SECRET=change-me
# One mediasoup worker per CPU core you want to dedicate to forwarding media.
RTC_WORKERS=4
ALLOW_GUESTS=true
